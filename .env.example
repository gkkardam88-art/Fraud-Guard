# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openai | ollama | fallback
LLM_PROVIDER=fallback

# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# Required only if LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ENV=development

# ── Kafka (optional — system works without it) ────────────────────────────────
KAFKA_BROKER=localhost:9092
PRODUCER_RATE=2.0
